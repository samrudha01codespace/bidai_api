{
  "info": {
    "_postman_id": "bidai-api-001",
    "name": "bidai_api",
    "description": "BID.ai marketplace API — auth, categories, image upload, products, orders.\n\nRun order: Auth → Categories → Uploads → Products → Orders.\nTests auto-save tokens, image_urls, product_id, order_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "seller_token", "value": "" },
    { "key": "buyer_token", "value": "" },
    { "key": "image_urls", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "order_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Body is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup Seller",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('seller_token', j.token);",
                  "if (j.user) pm.collectionVariables.set('seller_id', j.user.id);",
                  "if (j.token) pm.test('Has token + user', () => { pm.expect(j.user).to.have.property('mobile'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Seller One\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"seller@test.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/signup", "host": ["{{base_url}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "Signup Buyer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('buyer_token', j.token);",
                  "if (j.user) pm.collectionVariables.set('buyer_id', j.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Buyer One\",\n  \"mobile\": \"9123456780\",\n  \"email\": \"buyer@test.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/signup", "host": ["{{base_url}}"], "path": ["api", "auth", "signup"] }
          }
        },
